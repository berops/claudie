# {{ ansible_managed }}
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ node_ip }}
  bindPort: {{ api_server_port }}
nodeRegistration:
  name: {{ inventory_hostname }}
  kubeletExtraArgs:
    - name: node-ip
      value: {{ node_ip }}
skipPhases:
  - addon/kube-proxy
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: "{{ cluster_name }}"
kubernetesVersion: {{ kubernetes_version }}
controlPlaneEndpoint: {{ control_plane_endpoint }}
apiServer:
  certSANs:
{% for san in api_server_cert_sans %}
    - "{{ san }}"
{% endfor %}
  extraArgs:
    - name: profiling
      value: "false"
controllerManager:
  extraArgs:
    - name: profiling
      value: "false"
scheduler:
  extraArgs:
    - name: profiling
      value: "false"
etcd:
  local:
    extraArgs:
      # etcd has no profiling flag, enable-pprof is its equivalent.
      - name: enable-pprof
        value: "false"
      - name: corrupt-check-time
        value: 240m
      - name: feature-gates
        value: CompactHashCheck=true
    extraEnvs:
      - name: ETCDCTL_CACERT
        value: /etc/kubernetes/pki/etcd/ca.crt
      - name: ETCDCTL_CERT
        value: /etc/kubernetes/pki/etcd/healthcheck-client.crt
      - name: ETCDCTL_KEY
        value: /etc/kubernetes/pki/etcd/healthcheck-client.key
      - name: ETCDCTL_ENDPOINTS
        value: https://127.0.0.1:2379
networking:
  podSubnet: {{ pod_subnet }}
  serviceSubnet: {{ service_subnet }}
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
# Kubelets request their serving certificates from the cluster CA instead of
# self-signing them. The CSRs are approved by the kubelet-csr-approver deployed
# by kuber; metrics-server relies on this to scrape kubelets over verified TLS.
serverTLSBootstrap: true
rotateCertificates: true
# Same as kubeone, the kubelet default is 10Mi.
containerLogMaxSize: 100Mi
# Same as kubeone (CIS 1.8 / 4.2.12), the kubelet default allows insecure ciphers.
tlsCipherSuites:
  - TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
  - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
  - TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256
  - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
  - TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256
  - TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
systemReserved:
  memory: 200Mi
kubeReserved:
  memory: 200Mi
# Pods resolve through the NodeLocal DNSCache instead of the kube-dns service,
# kubeadm defaults this to the kube-dns IP and logs a warning about the override.
clusterDNS:
  - {{ node_local_dns_ip }}
