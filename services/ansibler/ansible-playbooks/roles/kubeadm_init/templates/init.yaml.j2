# {{ ansible_managed }}
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ node_ip }}
  bindPort: {{ api_server_port }}
nodeRegistration:
  name: {{ inventory_hostname }}
  kubeletExtraArgs:
    - name: node-ip
      value: {{ node_ip }}
skipPhases:
  - addon/kube-proxy
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: {{ kubernetes_version }}
controlPlaneEndpoint: {{ control_plane_endpoint }}
networking:
  podSubnet: {{ pod_subnet }}
  serviceSubnet: {{ service_subnet }}
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
# Kubelets request their serving certificates from the cluster CA instead of
# self-signing them. The CSRs are approved by the kubelet-csr-approver deployed
# by kuber; metrics-server relies on this to scrape kubelets over verified TLS.
serverTLSBootstrap: true
rotateCertificates: true
# Same as kubeone, the kubelet default is 10Mi.
containerLogMaxSize: 100Mi
# Pods resolve through the NodeLocal DNSCache instead of the kube-dns service,
# kubeadm defaults this to the kube-dns IP and logs a warning about the override.
clusterDNS:
  - {{ node_local_dns_ip }}
